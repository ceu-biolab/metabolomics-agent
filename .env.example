# Copy to .env, then supply a key locally. .env is ignored by Git.
LLM_API_KEY=
# Set the exact tool-calling model you want to test; no paid default is selected.
LLM_MODEL=
# Any service implementing the OpenAI Chat Completions function-tool contract.
LLM_BASE_URL=https://api.openai.com/v1
# Use responses for reasoning + tools on GPT-6 Luna/Sol; provider must support it.
LLM_API=chat_completions
# Blank keeps adapter/model defaults. Luna Chat Completions uses none.
# To enable reasoning: LLM_API=responses and LLM_REASONING_EFFORT=low (or higher).
LLM_REASONING_EFFORT=
LLM_MAX_TURNS=24
LLM_MAX_TOOL_CALLS=48
LLM_MAX_COMPLETION_TOKENS=2500
LLM_MAX_TOTAL_TOKENS=60000
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RUN_SECONDS=600
# Some compatible providers use max_tokens instead of max_completion_tokens.
LLM_TOKEN_PARAMETER=max_completion_tokens
# Optional provider-specific parameters, e.g. {"temperature": 0}.
LLM_EXTRA_JSON={}
